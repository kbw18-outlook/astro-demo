---
const { title_text } = Astro.props;
---

<!-- 内容接口叫 slot main -->
<!-- 左侧叫作slot left-->
<!-- 右侧是叫slot right -->
<!-- 需要传递一个Prop叫作title_text-->

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        background-color: #2d2d2c; /* 深色底色便于观察白线 */
        width: 100%;
        color: #f8fafc;
    }
    .page-container {
        margin: 0;
        min-height: 100dvh;
        width: 100%;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: 1fr minmax(auto, 90ch) 1fr;
    }

    /*外面容器 child Title 与 Content*/
    .side-left {
        /* 靠右对齐：让左侧的文字/导航紧贴分割线，视觉上不松散 */
        display: flex;
        padding-left: 15.8px;
        padding-right: 15.8px;
        flex-direction: column;
        align-items: flex-start;
        border-right: 1px solid rgba(255, 255, 255, 0.15);
        box-sizing: border-box;
    }

    /*
           中间主要内容区：
           紧挨着分割线右侧展开
    */
    .main-content {
        padding-left: 15.8px;
        padding-right: 15.8px;
        overflow-wrap: break-word;
        line-height: 1.8;
    }

    /*
           右侧容器：
           吸纳较多剩余空间，内容自然靠左开始排布
    */
    .side-right {
        padding-left: 15.8px;
        padding-right: 15.8px;
        border-left: 1px solid rgba(255, 255, 255, 0.15);
    }
</style>

<html lang="zh-cn">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title_text}</title>
    </head>
    <body>
        <div class="page-container">
            <!-- 左侧：原本留白的区域 -->
            <aside class="side-left">
                <slot name="left" />
            </aside>

            <!-- 中间：核心阅读区（限制字符数） -->
            <main class="main-content">
                <slot name="main" />
            </main>

            <!-- 右侧：中间文字限制之后的区域 -->
            <aside class="side-right">
                <slot name="right" />
            </aside>
        </div>
    </body>
</html>
